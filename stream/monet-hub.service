[Unit]
Description=HDMI capture hub (preview, box.jpg frames, cast stream)
# Settings come from ~/.config/dashboard/hub.env, written by capture/tvctl.py.
After=mediamtx.service
Wants=mediamtx.service

[Service]
EnvironmentFile=-%h/.config/dashboard/hub.env
ExecStart=%h/stream/capture-hub.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
