[Unit]
Description=Fake TVIP Bluetooth remote (HID over GATT) for the dashboard
Requires=bluetooth.service bt-identity.service
After=bluetooth.service bt-identity.service

[Service]
User=verge
ExecStart=/usr/bin/python3 /home/verge/dashboard/capture/bt_remote.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
